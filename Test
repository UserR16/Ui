--// Mobile UI Library
local Lib = {}

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer

--// THEME
Lib.Theme = {
    BG = Color3.fromRGB(18,18,18),
    Side = Color3.fromRGB(14,14,14),
    Box = Color3.fromRGB(25,25,25),
    Accent = Color3.fromRGB(255,60,60),
    Text = Color3.fromRGB(230,230,230)
}

--// CREATE WINDOW
function Lib:CreateWindow(titleText)
    local gui = Instance.new("ScreenGui", player.PlayerGui)
    gui.Name = "MobileUILib"
    gui.ResetOnSpawn = false

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.fromScale(0.85,0.7)
    main.Position = UDim2.fromScale(0.5,0.5)
    main.AnchorPoint = Vector2.new(0.5,0.5)
    main.BackgroundColor3 = self.Theme.BG
    main.Active = true

    Instance.new("UICorner", main).CornerRadius = UDim.new(0,14)
    Instance.new("UIStroke", main).Color = self.Theme.Accent

    -- Drag mobile
    do
        local drag, start, pos
        main.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch then
                drag = true
                start = i.Position
                pos = main.Position
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if drag and i.UserInputType == Enum.UserInputType.Touch then
                local d = i.Position - start
                main.Position = UDim2.new(
                    pos.X.Scale,pos.X.Offset+d.X,
                    pos.Y.Scale,pos.Y.Offset+d.Y
                )
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch then drag = false end
        end)
    end

    -- Sidebar
    local side = Instance.new("Frame", main)
    side.Size = UDim2.fromScale(0.25,1)
    side.BackgroundColor3 = self.Theme.Side
    Instance.new("UICorner", side).CornerRadius = UDim.new(0,14)

    local title = Instance.new("TextLabel", side)
    title.Size = UDim2.new(1,0,0,50)
    title.Text = titleText or "UI Library"
    title.TextColor3 = self.Theme.Accent
    title.Font = Enum.Font.GothamBold
    title.TextSize = 20
    title.BackgroundTransparency = 1

    local content = Instance.new("Frame", main)
    content.Position = UDim2.fromScale(0.25,0)
    content.Size = UDim2.fromScale(0.75,1)
    content.BackgroundTransparency = 1

    local Window = {}
    Window.Tabs = {}
    Window.CurrentTab = nil

    -- ADD TAB
    function Window:AddTab(name)
        local btn = Instance.new("TextButton", side)
        btn.Size = UDim2.new(1,-10,0,40)
        btn.Position = UDim2.new(0,5,0,60 + (#Window.Tabs*45))
        btn.Text = name
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        btn.TextColor3 = Lib.Theme.Text
        btn.BackgroundColor3 = Lib.Theme.Box
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0,8)

        local page = Instance.new("ScrollingFrame", content)
        page.Size = UDim2.fromScale(1,1)
        page.CanvasSize = UDim2.new(0,0,2,0)
        page.ScrollBarImageTransparency = 1
        page.Visible = false

        local layout = Instance.new("UIListLayout", page)
        layout.Padding = UDim.new(0,10)

        btn.MouseButton1Click:Connect(function()
            if Window.CurrentTab then
                Window.CurrentTab.Page.Visible = false
            end
            page.Visible = true
            Window.CurrentTab = {Page = page}
        end)

        if not Window.CurrentTab then
            page.Visible = true
            Window.CurrentTab = {Page = page}
        end

        local Tab = {}

        -- TOGGLE
        function Tab:AddToggle(text, callback)
            local t = Instance.new("TextButton", page)
            t.Size = UDim2.new(1,-40,0,40)
            t.Text = text.." : OFF"
            t.BackgroundColor3 = Lib.Theme.Box
            t.TextColor3 = Lib.Theme.Text
            t.Font = Enum.Font.Gotham
            t.TextSize = 14
            Instance.new("UICorner", t).CornerRadius = UDim.new(0,8)

            local state = false
            t.MouseButton1Click:Connect(function()
                state = not state
                t.Text = text.." : "..(state and "ON" or "OFF")
                t.BackgroundColor3 = state and Lib.Theme.Accent or Lib.Theme.Box
                if callback then callback(state) end
            end)
        end

        -- SLIDER
        function Tab:AddSlider(text, min, max, callback)
            local holder = Instance.new("Frame", page)
            holder.Size = UDim2.new(1,-40,0,60)
            holder.BackgroundTransparency = 1

            local label = Instance.new("TextLabel", holder)
            label.Size = UDim2.new(1,0,0,20)
            label.Text = text..": "..min
            label.TextColor3 = Lib.Theme.Text
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.TextSize = 13

            local bar = Instance.new("Frame", holder)
            bar.Position = UDim2.new(0,0,0,30)
            bar.Size = UDim2.new(1,0,0,6)
            bar.BackgroundColor3 = Color3.fromRGB(40,40,40)
            Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

            local fill = Instance.new("Frame", bar)
            fill.Size = UDim2.fromScale(0,1)
            fill.BackgroundColor3 = Lib.Theme.Accent
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)

            bar.InputChanged:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.Touch then
                    local x = math.clamp(
                        (i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
                        0,1
                    )
                    fill.Size = UDim2.fromScale(x,1)
                    local val = math.floor(min + (max-min)*x)
                    label.Text = text..": "..val
                    if callback then callback(val) end
                end
            end)
        end

        table.insert(Window.Tabs, Tab)
        return Tab
    end

    return Window
end

return Lib
